# ==============================================================================
# Comprehensive .gitignore
# Ignores: .sql, .conf, node_modules, .env, and all common junk
# Tracks: everything else
# ==============================================================================

# ------------------------------------------------------------------------------
# SQL and config files
# ------------------------------------------------------------------------------
*.sql
*.sql.bak
*.sql.gz
*.sql.zip
*.sql.xz
*.conf
*.conf.bak
*.conf.local
*.conf.dist
*.conf.*
*.cnf
*.cnf.local
*.ini
*.config.js
*.config.cjs
*.config.ts
*.config.json

# ------------------------------------------------------------------------------
# Node.js
# ------------------------------------------------------------------------------
node_modules/
node_modules.lock
npm-debug.log*
npm-error.log*
yarn-debug.log*
yarn-error.log*
yarn-log-*
pnpm-debug.log*
package-lock.json
yarn-lock.yaml
pnpm-lock.yaml
yarn-packages/
npm-shrinkwrap.lock
.npm/
.node-gyp/
.pnpm/

# ------------------------------------------------------------------------------
# Environment Variables
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local
.envrc
.ads/.env
*.secret
*.pem
*.key

# ------------------------------------------------------------------------------
# Build Outputs
# ------------------------------------------------------------------------------
dist/
dist-ssr/
dist-client/
build/
.out/
output/
.next/
.nuxt/
.vuepress/
.server/
.functions/
.vercel/
.netlify/
.parcel-cache/
*.js.bundle
*.js.br
*.js.gz
*.mjs.map
*.cjs.map

